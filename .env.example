# Agent HTTP service
AGENT_HOST=0.0.0.0
AGENT_PORT=3400

# Module MCP endpoints. These are deliberately deployment-specific because
# the dashboard and agent are separate repositories/compose projects.
BUS_MCP_URL=http://localhost:3200/mcp
FLIGHTS_MCP_URL=http://localhost:3201/mcp
TASKS_MCP_URL=http://localhost:3202/mcp
WEATHER_MCP_URL=http://localhost:3203/mcp

# Timeouts (milliseconds) for module MCP calls and LLM requests.
MCP_TIMEOUT_MS=10000
LLM_TIMEOUT_MS=30000

# Select and configure an OpenAI-compatible LLM provider outside Git.
# Defaults to OpenCode Go; use the OpenCode free model or Ollama by changing
# LLM_BASE_URL and LLM_MODEL. Cloud endpoints are opt-in data-egress paths.
# OpenCode Go base URL: https://opencode.ai/inference/go/openai/v1
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=

# Authentication.
# Recommended: keep tokens in a readable JSON file (git-ignored) with:
#   pnpm token:generate -- --caller-id <you> --permissions read,write,destructive --out secrets/tokens.json
AGENT_TOKENS_FILE=secrets/tokens.json
# Alternative: inline a single-line JSON map (keys are sha-256 hashes of the
# bearer tokens). Inline entries are merged over the file when both are set.
AGENT_AUTH_TOKENS={}

# Conversation policy.
CONFIRMATION_TTL_MS=120000
AGENT_MAX_TOOL_ITERATIONS=4
# Cap tool output fed back to the model (prevents oversized contexts/timeouts).
AGENT_MAX_TOOL_RESULT_CHARS=8000
AGENT_UNKNOWN_TOOL_POLICY=destructive

# Logging. Redaction is on by default and tool calls are visible at info level.
LOG_LEVEL=info
LOG_REDACT=true

# Home Assistant adapter endpoint and shared secret belong in deployment secrets.
HOME_ASSISTANT_URL=http://home-assistant:8123
HOME_ASSISTANT_TOKEN=
